@page
@using BusinessPermitLicensingSystem.Web.Vehicles
@model BusinessPermitLicensingSystem.Web.Pages.Vehicles.IndexModel
@{
    ViewData["Title"] = "Special Vehicle Permits";
}
<div class="page-header"><div><p class="eyebrow">Records</p><h1>Special Vehicle Permits</h1><p>Manage vehicle details, fee drafts, and permit payments.</p></div><div class="page-actions"><a class="btn btn-outline-secondary" asp-page="/Vehicles/Transfer">Import / Export</a><a class="btn btn-primary" asp-page="/Vehicles/Edit">Add Vehicle</a></div></div>
<form method="get" class="search-panel row g-2 align-items-end mb-3">
    <div class="col-md-5"><label for="vehicle-search" class="form-label">Search Vehicles</label><input id="vehicle-search" class="form-control" name="search" value="@Model.Search" placeholder="VIN, company, driver, or plate number" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Search</button></div>
    @if (!string.IsNullOrWhiteSpace(Model.Search)) { <div class="col-auto"><a class="btn btn-link" asp-page="/Vehicles/Index">Clear Search</a></div> }
</form>
@if (Model.Error is not null) { <p class="text-danger" role="alert">@Model.Error</p> }
else if (Model.Result is not null)
{
    <p class="record-count">@Model.Result.Total active special vehicle permits</p>
    <div class="table-responsive"><table class="table table-striped table-sm"><caption class="visually-hidden">Active special vehicle permits</caption>
        <thead><tr><th scope="col">VIN</th><th scope="col">Company</th><th scope="col">Driver</th><th scope="col">Plate Number</th><th scope="col">@DateTime.Today.Year permit</th><th scope="col">Actions</th></tr></thead>
        <tbody>
        @foreach (var vehicle in Model.Result.Items)
        {
            <tr><td>@vehicle.Vin</td>
                <td>@vehicle.Company</td><td>@vehicle.Driver</td><td>@vehicle.Plate</td>
                <td><span class="status-badge @vehicle.CurrentYearStatus.ToLowerInvariant()">@vehicle.CurrentYearStatus</span></td>
                <td><a asp-page="/Vehicles/Details" asp-route-vin="@vehicle.Vin">View Profile</a> · <a asp-page="/Vehicles/Edit" asp-route-vin="@vehicle.Vin">Edit</a></td></tr>
        }
        </tbody>
    </table></div>
    @if (Model.Result.Items.Count == 0) { <p class="empty-state">No vehicles match your search.</p> }
    @if (Model.CurrentPage > 1)
    { <a class="btn btn-outline-secondary" asp-page="/Vehicles/Index" asp-route-search="@Model.Search" asp-route-page="@(Model.CurrentPage - 1)">Previous Page</a> }
    @if (Model.CurrentPage * VehicleService.PageSize < Model.Result.Total)
    { <a class="btn btn-outline-secondary" asp-page="/Vehicles/Index" asp-route-search="@Model.Search" asp-route-page="@(Model.CurrentPage + 1)">Next Page</a> }
}
