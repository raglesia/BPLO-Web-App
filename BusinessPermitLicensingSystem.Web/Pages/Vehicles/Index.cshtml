@page
@using BusinessPermitLicensingSystem.Web.Vehicles
@model BusinessPermitLicensingSystem.Web.Pages.Vehicles.IndexModel
@{
    ViewData["Title"] = "Special Vehicle Permits";
}
<div class="page-header"><div><p class="eyebrow">Records</p><h1>Special Vehicle Permits</h1><p>Manage vehicle profiles and review permit status and payment history.</p></div><div class="page-actions"><a class="btn btn-outline-secondary" asp-page="/Vehicles/Transfer">Import / Export</a><a class="btn btn-primary" asp-page="/Vehicles/Edit">Add Vehicle</a></div></div>
<form method="get" data-live-search class="search-panel row g-2 align-items-end mb-3">
    <div class="col-md-5"><label for="vehicle-search" class="form-label">Search Vehicles</label><input id="vehicle-search" class="form-control" name="search" value="@Model.Search" placeholder="VIN, company, driver, or plate number" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Search</button></div>
    @if (!string.IsNullOrWhiteSpace(Model.Search)) { <div class="col-auto"><a class="btn btn-link" asp-page="/Vehicles/Index">Clear Search</a></div> }
</form>
<p class="form-text" data-search-status role="status" aria-live="polite"></p><div data-search-results><partial name="_Results" model="Model" /></div>
@section Scripts { <script src="~/js/live-list-search.js" asp-append-version="true"></script> }
