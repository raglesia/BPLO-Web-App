@page
@model BusinessPermitLicensingSystem.Web.Pages.Reports.MonthlyModel
@{ ViewData["Title"] = "Monthly collection summary"; }
<div class="report-header text-center mb-4">
    <p class="mb-0">Municipality of Masinloc<br />Business Permit and Licensing Office</p>
    <h1 class="h3 mt-3">Monthly collection summary report</h1>
    @if (Model.Report is not null) { <p>@Model.Report.From.ToString("MMMM yyyy") – @Model.Report.To.ToString("MMMM yyyy")</p> }
    <p>Generated @DateTime.Now.ToString("MMMM dd, yyyy hh:mm tt")</p>
</div>
<form method="get" class="report-controls search-panel row g-2 mb-4">
    <div class="col-auto"><label asp-for="FromMonth">From month</label><input asp-for="FromMonth" type="number" min="1" max="12" class="form-control" required /></div>
    <div class="col-auto"><label asp-for="FromYear">From year</label><input asp-for="FromYear" type="number" min="2000" max="2100" class="form-control" required /></div>
    <div class="col-auto"><label asp-for="ToMonth">To month</label><input asp-for="ToMonth" type="number" min="1" max="12" class="form-control" required /></div>
    <div class="col-auto"><label asp-for="ToYear">To year</label><input asp-for="ToYear" type="number" min="2000" max="2100" class="form-control" required /></div>
    <div class="col-auto align-self-end"><button type="submit" class="btn btn-primary">View report</button></div>
</form>
@if (Model.Error is not null) { <p class="text-danger" role="alert">@Model.Error</p> }
@if (Model.Report is not null)
{
    <div class="report-controls mb-3">
        <button type="button" class="btn btn-outline-primary" onclick="window.print()">Print</button>
        <a class="btn btn-outline-secondary" asp-page-handler="Download" asp-route-FromYear="@Model.FromYear" asp-route-FromMonth="@Model.FromMonth" asp-route-ToYear="@Model.ToYear" asp-route-ToMonth="@Model.ToMonth">Download Excel</a>
        <a asp-page="/Reports/Index">Back to reports</a>
    </div>
    <p>Billing rows use selected billing periods. Collection uses payments recorded during selected months, including archived owners. A payment may cover bills outside this range.</p>
    @if (Model.Report.ReviewNeeded) { <p class="text-danger" role="alert">Review needed: one or more legacy bills have an unknown rent basis. No authoritative billed total is shown.</p> }
    <dl class="row detail-list section-panel">
        <dt class="col-sm-4">Owners with bills</dt><dd class="col-sm-8">@Model.Report.OwnerCount</dd>
        <dt class="col-sm-4">Billing periods</dt><dd class="col-sm-8">@Model.Report.Bills.Count</dd>
        <dt class="col-sm-4">Paid / unpaid bills</dt><dd class="col-sm-8">@Model.Report.PaidCount / @Model.Report.UnpaidCount</dd>
        <dt class="col-sm-4">Billed total</dt><dd class="col-sm-8">@(Model.Report.BilledTotal?.ToString("N2") ?? "Review needed")</dd>
        <dt class="col-sm-4">Unpaid total</dt><dd class="col-sm-8">@(Model.Report.UnpaidTotal?.ToString("N2") ?? "Review needed")</dd>
        <dt class="col-sm-4">Collected by payment date</dt><dd class="col-sm-8">@Model.Report.CollectedTotal.ToString("N2")</dd>
        <dt class="col-sm-4">Penalty collected</dt><dd class="col-sm-8">@Model.Report.PenaltyCollected.ToString("N2")</dd>
    </dl>
    <h2 class="h4">Billing snapshots</h2>
    <div class="table-responsive"><table class="table table-sm table-striped">
        <thead><tr><th scope="col">Period</th><th scope="col">SIN</th><th scope="col">Owner</th><th scope="col">Base</th><th scope="col">Additional</th><th scope="col">Penalty</th><th scope="col">Total</th><th scope="col">Status</th></tr></thead>
        <tbody>@foreach (var item in Model.Report.Bills)
        { <tr><td>@item.Bill.Year-@item.Bill.Month.ToString("D2")</td><td>@item.Sin</td><td>@item.Owner @(item.Archived ? "(archived)" : "")</td>
            <td>@(item.Bill.BaseRent?.ToString("N2") ?? "Review needed")</td><td>@item.Bill.Additional.ToString("N2")</td>
            <td>@item.Bill.Penalty.ToString("N2")</td><td>@(item.Bill.Total?.ToString("N2") ?? "Review needed")</td><td>@item.Bill.Status</td></tr> }</tbody>
    </table></div>
    <h2 class="h4">Recorded collections</h2>
    <div class="table-responsive"><table class="table table-sm table-striped">
        <thead><tr><th scope="col">SIN</th><th scope="col">Owner</th><th scope="col">Date</th><th scope="col">OR</th><th scope="col">Amount</th><th scope="col">Penalty</th><th scope="col">Recorded by</th><th scope="col">Covered periods</th></tr></thead>
        <tbody>@foreach (var payment in Model.Report.Payments)
        { <tr><td>@payment.Sin</td><td>@payment.Owner</td><td>@payment.PaidAt.ToString("yyyy-MM-dd")</td><td>@payment.OrNumber</td><td>@payment.Amount.ToString("N2")</td>
            <td>@payment.Penalty.ToString("N2")</td><td>@payment.Recorder</td><td>@(payment.Periods.Length == 0 ? "No period link recorded" : payment.Periods)</td></tr> }</tbody>
    </table></div>
    <p class="small">Prepared by @User.FindFirst("FullName")?.Value (@User.FindFirst("Position")?.Value)</p>
}
