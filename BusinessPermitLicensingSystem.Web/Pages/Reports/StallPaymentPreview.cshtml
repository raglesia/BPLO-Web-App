@page
@model BusinessPermitLicensingSystem.Web.Pages.Reports.StallPaymentPreviewModel
@{ ViewData["Title"] = "Rental Payment Report"; }
<div class="page-header rental-preview-toolbar"><h1>Rental Payment Report</h1><div class="page-actions"><a href="@(Url.IsLocalUrl(Request.Query["returnUrl"].ToString()) ? Request.Query["returnUrl"].ToString() : Url.Page("/Payments/Stalls", new {sin=Model.Sin}))" class="btn btn-outline-secondary">Back</a>@if(Model.Payment is not null) { <button type="button" class="btn btn-primary" onclick="window.print()">Print</button> }</div></div>
@if(Model.Error is not null) { <p class="alert alert-danger" role="alert">@Model.Error</p> }
@if(Model.Payment is {} payment) {
<div class="rental-paper"><article class="rental-payment-block">
<div class="rental-document-heading payment-report-heading"><img src="~/images/masinloc-logo.jpg" alt="Municipality of Masinloc seal" width="70" height="70"/><div><strong>Municipality of Masinloc</strong><span>Province of Zambales</span><span>Business Permit and Licensing Office</span><h2>RENTAL PAYMENT REPORT</h2></div><img src="~/images/mayors-permit/bplo-logo.jpg" alt="Business Permits and Licensing Office logo" width="70" height="70" /></div>
<dl class="rental-info-grid"><div><dt>Stall Owner</dt><dd>@Model.Record!.Name</dd></div><div><dt>SIN</dt><dd>@Model.Sin</dd></div><div><dt>OR Number</dt><dd>@payment.OrNumber</dd></div><div><dt>Payment Date</dt><dd>@payment.DatePaid.ToString("MMMM dd, yyyy hh:mm tt")</dd></div><div><dt>Recorded By</dt><dd>@payment.RecordedBy</dd></div><div><dt>Covered Periods</dt><dd>@(string.IsNullOrWhiteSpace(payment.Periods) ? "No period link recorded" : payment.Periods)</dd></div></dl>
<h3 class="rental-table-heading">Settled Rental Items</h3>
<table class="rental-charge-table"><thead><tr><th scope="col">Rental Period</th><th scope="col">Base Rent</th><th scope="col">Additional</th><th scope="col">Penalty</th><th scope="col">Total</th></tr></thead><tbody>
@foreach(var item in Model.Items) {
    decimal? itemTotal = item.BaseRent is decimal rent ? rent + item.Additional + item.Penalty : null;
    <tr><td>@(new DateTime(item.Year,item.Month,1).ToString("MMMM yyyy"))@(item.Arrears ? " (arrears)" : "")</td><td>@(item.BaseRent?.ToString("₱#,##0.00") ?? "Unavailable")</td><td>₱@item.Additional.ToString("N2")</td><td>₱@item.Penalty.ToString("N2")</td><td>@(itemTotal?.ToString("₱#,##0.00") ?? "Unavailable")</td></tr>
}
@if(Model.Items.Count == 0) { <tr><td colspan="5">Itemized details are unavailable for this historical payment.</td></tr> }
</tbody></table>
@if(Model.Items.Count > 0 && (Model.Items.Any(x=>x.BaseRent is null) || Model.Items.Sum(x=>(x.BaseRent ?? 0)+x.Additional+x.Penalty) != payment.Amount)) { <p class="rental-review-note">Linked item details need review. The recorded payment total below remains authoritative.</p> }
<table class="rental-charge-table mt-3"><tbody><tr><th scope="row">Recorded Penalty</th><td>₱@payment.Penalty.ToString("N2")</td></tr><tr class="rental-total"><th scope="row">Total Amount Paid</th><td>₱@payment.Amount.ToString("N2")</td></tr></tbody></table><p class="rental-scope">Recorded payment history is authoritative. Current outstanding bills are not included in this payment amount.</p>
<div class="rental-document-footer"><div><span>Processed By:</span><strong class="rental-signature-name">@Model.ProcessedBy</strong><span>@Model.Position</span></div><p>Date Printed: @Model.PrintedAt.ToString("MMMM dd, yyyy hh:mm tt") PHT</p></div>
</article></div>
}
