@page
@model BusinessPermitLicensingSystem.Web.Pages.Payments.PaymentsIndexModel
@{ViewData["Title"]="Billing & Payments";}
<header class="page-header"><div><p class="eyebrow">Treasury workspace</p><h1>Billing &amp; Payments</h1><p>Select a record to review its assessment, outstanding obligations or recorded payments.</p></div></header>
<nav class="page-actions mb-3" aria-label="Payment categories"><a class="btn @(Model.Kind=="stalls"?"btn-primary":"btn-outline-primary")" asp-page="/Payments/Index" asp-route-kind="stalls" aria-current="@(Model.Kind=="stalls"?"page":null)">Stall Rentals</a><a class="btn @(Model.Kind=="vehicles"?"btn-primary":"btn-outline-primary")" asp-page="/Payments/Index" asp-route-kind="vehicles" aria-current="@(Model.Kind=="vehicles"?"page":null)">Vehicle Permits</a></nav>
<form method="get" class="search-panel"><input type="hidden" name="kind" value="@Model.Kind" /><label for="payment-search" class="form-label">@(Model.Kind=="stalls"?"Search stall owners":"Search vehicles")</label><div class="input-group"><input id="payment-search" class="form-control" name="search" value="@Model.Search" maxlength="255" placeholder="Name or record number" /><button class="btn btn-outline-primary">Search</button></div></form>
@if(Model.Error is not null){<p class="alert alert-danger">@Model.Error</p>}
else {
<div class="table-responsive mt-3"><table class="table financial-table"><thead><tr><th>Record</th><th>Name / Company</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@if(Model.Kind=="stalls") { foreach(var record in Model.Profiles){<tr><td>@record.Sin</td><td>@record.FullName</td><td>@record.PaymentStatus</td><td><a asp-page="/Payments/Stalls" asp-route-listSearch="@Model.Search" asp-route-listPage="@Model.PageNumber" asp-route-sin="@record.Sin">Billing &amp; Payments</a> · <a asp-page="/Profiles/Details" asp-route-sin="@record.Sin">View Profile</a></td></tr>} }
else if(Model.Vehicles is not null){foreach(var record in Model.Vehicles.Items){<tr><td>@record.Vin</td><td>@record.Company</td><td>@record.CurrentYearStatus</td><td><a asp-page="/Payments/Vehicles" asp-route-listSearch="@Model.Search" asp-route-listPage="@Model.PageNumber" asp-route-vin="@record.Vin">Billing &amp; Payments</a> · <a asp-page="/Vehicles/Details" asp-route-vin="@record.Vin">View Profile</a></td></tr>}}
</tbody></table></div>
@if((Model.Kind=="stalls"&&Model.Profiles.Count==0)||(Model.Kind=="vehicles"&&Model.Vehicles?.Items.Count==0)){<p class="empty-state">No matching records.</p>}
<nav class="page-actions" aria-label="Payment records pages">@if(Model.PageNumber>1){<a asp-page="/Payments/Index" asp-route-kind="@Model.Kind" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.PageNumber-1)">Previous</a>}<span>Page @Model.PageNumber of @Model.TotalPages</span>@if(Model.PageNumber<Model.TotalPages){<a asp-page="/Payments/Index" asp-route-kind="@Model.Kind" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.PageNumber+1)">Next</a>}</nav>
}

