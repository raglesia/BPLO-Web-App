@page
@model BusinessPermitLicensingSystem.Web.Pages.Payments.PaymentsIndexModel
@{ViewData["Title"]="Billing & Payments";}
<header class="page-header"><div><p class="eyebrow">Treasury workspace</p><h1>Billing &amp; Payments</h1><p>Select a record to review its assessment, outstanding obligations or recorded payments.</p></div></header>
<nav class="page-actions payment-categories mb-3" aria-label="Payment categories"><a class="btn @(Model.Kind=="stalls"?"btn-primary":"btn-outline-primary")" asp-page="/Payments/Index" asp-route-kind="stalls" aria-current="@(Model.Kind=="stalls"?"page":null)">Stall Rentals</a><a class="btn @(Model.Kind=="vehicles"?"btn-primary":"btn-outline-primary")" asp-page="/Payments/Index" asp-route-kind="vehicles" aria-current="@(Model.Kind=="vehicles"?"page":null)">Vehicle Permits</a></nav>
<form method="get" class="search-panel"><input type="hidden" name="kind" value="@Model.Kind" /><label for="payment-search" class="form-label">@(Model.Kind=="stalls"?"Search stall owners":"Search vehicles")</label><div class="input-group"><input id="payment-search" class="form-control" name="search" value="@Model.Search" maxlength="255" placeholder="Name or record number" /><button class="btn btn-outline-primary">Search</button></div>@if (!string.IsNullOrEmpty(Model.Search)) { <a asp-page="/Payments/Index" asp-route-kind="@Model.Kind" class="btn btn-link">Clear search</a> }</form>
@if(Model.Error is not null){<p class="alert alert-danger" role="alert">@Model.Error <a asp-page="/Payments/Index" asp-route-kind="@Model.Kind" asp-route-search="@Model.Search" asp-route-pageNumber="@Model.PageNumber">Retry search</a></p>}
else {
<p class="record-count" role="status">@Model.TotalCount matching records</p><div class="table-responsive record-results-table mt-3" tabindex="0" role="region" aria-label="Payment records"><table class="table financial-table"><thead><tr><th scope="col">Record</th><th scope="col">Name / Company</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody>
@if(Model.Kind=="stalls") { foreach(var record in Model.Profiles){<tr><td class="record-id">@record.Sin</td><td><a asp-page="/Payments/Stalls" asp-route-listSearch="@Model.Search" asp-route-listPage="@Model.PageNumber" asp-route-sin="@record.Sin">@record.FullName</a></td><td><span class="status-badge @record.PaymentStatus.ToLowerInvariant()">@record.PaymentStatus</span></td><td><a asp-page="/Profiles/Details" asp-route-sin="@record.Sin">View profile</a></td></tr>} }
else if(Model.Vehicles is not null){foreach(var record in Model.Vehicles.Items){<tr><td class="record-id">@record.Vin</td><td><a asp-page="/Payments/Vehicles" asp-route-listSearch="@Model.Search" asp-route-listPage="@Model.PageNumber" asp-route-vin="@record.Vin">@record.Company</a></td><td><span class="status-badge @record.CurrentYearStatus.ToLowerInvariant()">@record.CurrentYearStatus</span></td><td><a asp-page="/Vehicles/Details" asp-route-vin="@record.Vin">View profile</a></td></tr>}}
</tbody></table></div>
@if((Model.Kind=="stalls"&&Model.Profiles.Count==0)||(Model.Kind=="vehicles"&&Model.Vehicles?.Items.Count==0)){<p class="empty-state">No matching records.</p>}
@if (Model.TotalPages > 1) {
<nav class="record-pagination" aria-label="Payment records pages">@if(Model.PageNumber>1){<a class="btn btn-sm btn-outline-secondary" asp-page="/Payments/Index" asp-route-kind="@Model.Kind" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.PageNumber-1)">Previous</a>}<span aria-current="page">Page @Model.PageNumber of @Model.TotalPages</span>@if(Model.PageNumber<Model.TotalPages){<a class="btn btn-sm btn-outline-secondary" asp-page="/Payments/Index" asp-route-kind="@Model.Kind" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.PageNumber+1)">Next</a>}</nav>
}
}

