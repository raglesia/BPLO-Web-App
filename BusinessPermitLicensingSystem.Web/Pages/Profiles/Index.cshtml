@page
@model ProfilesIndexModel
@{
    ViewData["Title"] = "Stall owners";
}

<div class="page-header">
    <div><p class="eyebrow">Records</p><h1>Stall Owners</h1><p>Find a profile, review its billing, or update its details.</p></div>
    <div class="page-actions"><a class="btn btn-outline-secondary" asp-page="/Profiles/Transfer">Import / Export</a><a class="btn btn-primary" asp-page="/Profiles/Create">Add Profile</a></div>
</div>
<form method="get" data-live-search class="search-panel row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label for="search" class="form-label">Search Profiles</label>
        <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="SIN, owner, business, or section" />
    </div>
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Search</button></div>
    @if (!string.IsNullOrWhiteSpace(Model.Search)) { <div class="col-auto"><a class="btn btn-link" asp-page="/Profiles/Index">Clear Search</a></div> }
</form>

<p class="form-text" data-search-status role="status" aria-live="polite"></p><div data-search-results><partial name="_Results" model="Model" /></div>
@section Scripts { <script src="~/js/live-list-search.js" asp-append-version="true"></script> }
