@page "{sin}"
@model ProfileDetailsModel
@{
    ViewData["Title"] = "Profile details";
}

<div class="page-header"><div><p class="eyebrow">Stall owners</p><h1>Profile Details</h1><p>Review the record before editing or recording payment.</p></div></div>
@if (Model.Notice is not null) { <p class="text-success" role="status">@Model.Notice</p> }
@if (Model.LoadError is not null)
{
    <p class="text-danger" role="alert">@Model.LoadError</p>
}
else if (Model.Profile is not null)
{
    <section class="section-panel"><h2 class="section-heading">Owner and Stall</h2><dl class="row detail-list">
        <dt class="col-sm-3">SIN</dt><dd class="col-sm-9">@Model.Profile.Sin</dd>
        <dt class="col-sm-3">Full name</dt><dd class="col-sm-9">@Model.Profile.FullName</dd>
        <dt class="col-sm-3">Business name</dt><dd class="col-sm-9">@Model.Profile.BusinessName</dd>
        <dt class="col-sm-3">Business section</dt><dd class="col-sm-9">@Model.Profile.BusinessSection</dd>
        <dt class="col-sm-3">Stall number</dt><dd class="col-sm-9">@Model.Profile.StallNumber</dd>
        <dt class="col-sm-3">Stall size</dt><dd class="col-sm-9">@Model.Profile.StallSize</dd>
        <dt class="col-sm-3">Date of occupancy</dt><dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Profile.StartDate) ? "Unverified" : Model.Profile.StartDate)</dd>
        @if (Model.Profile.IsLegacyBaseline) { <dt class="col-sm-3">Date source</dt><dd class="col-sm-9">Computerized tracking baseline; historical occupancy date not verified</dd> }
        <dt class="col-sm-3">Monthly rental</dt><dd class="col-sm-9 money">₱@Model.Profile.MonthlyRental.ToString("N2")</dd>
        <dt class="col-sm-3">Additional charge</dt><dd class="col-sm-9 money">₱@Model.Profile.AdditionalCharge.ToString("N2")</dd>
        <dt class="col-sm-3">Payment status</dt><dd class="col-sm-9"><span class="status-badge @Model.Profile.PaymentStatus.ToLowerInvariant()">@Model.Profile.PaymentStatus</span></dd>
    </dl></section>
    <div class="page-actions"><a class="btn btn-primary" asp-page="/Profiles/Edit" asp-route-sin="@Model.Profile.Sin">Edit Profile</a>
    <a class="btn btn-outline-primary" asp-page="/Payments/Stalls" asp-route-sin="@Model.Profile.Sin">Go to Billing &amp; Payments</a>
    </div>
    @if(Model.FinancialSummary is {} financial) {
    <section class="section-panel mt-4"><h2 class="section-heading">Billing Status and Payment Records</h2>
    <p>Outstanding total: <strong>@(financial.TotalDue?.ToString("₱#,##0.00") ?? "Review needed")</strong>. Billing actions are available in Billing &amp; Payments.</p>
    <div class="table-responsive"><table class="table financial-table"><thead><tr><th>Rental period</th><th>Status</th><th>Base rent</th><th>Additional</th><th>OR number</th></tr></thead><tbody>
    @foreach(var row in financial.Rows){<tr><td>@(new DateTime(row.Year,row.Month,1).ToString("MMMM yyyy"))</td><td>@row.Status</td><td>@(row.BaseRent?.ToString("₱#,##0.00") ?? "Review needed")</td><td>₱@row.Additional.ToString("N2")</td><td>@row.OrNumber</td></tr>}
    </tbody></table></div>
    @if(financial.Rows.Count==0){<p class="empty-state">No billing periods yet.</p>}
    @if(financial.Arrears.Count>0){<h3>Treasury-Verified Arrears</h3><div class="table-responsive"><table class="table financial-table"><thead><tr><th>Period</th><th>Status</th><th>Base rent</th><th>Additional</th></tr></thead><tbody>@foreach(var item in financial.Arrears){<tr><td>@(new DateTime(item.Year,item.Month,1).ToString("MMMM yyyy"))</td><td>@(item.IsPaid?"Paid":"Unpaid")</td><td>₱@item.BaseRent.ToString("N2")</td><td>₱@item.Additional.ToString("N2")</td></tr>}</tbody></table></div>}
    <h3>Payment Records</h3><div class="table-responsive"><table class="table financial-table"><thead><tr><th>OR number</th><th>Date</th><th>Amount paid</th><th>Covered periods</th><th>Report</th></tr></thead><tbody>
    @foreach(var payment in financial.Payments){<tr><td>@payment.OrNumber</td><td>@payment.DatePaid.ToString("yyyy-MM-dd HH:mm")</td><td>₱@payment.Amount.ToString("N2")</td><td>@payment.Periods</td><td><a asp-page="/Reports/StallPaymentPreview" asp-route-sin="@Model.Profile.Sin" asp-route-orNumber="@payment.OrNumber" asp-route-returnUrl="@Url.Page("/Profiles/Details",new {sin=Model.Profile.Sin})">Print Rental Payment Report</a></td></tr>}
    </tbody></table></div>@if(financial.Payments.Count==0){<p class="empty-state">No recorded payments.</p>}
    </section>
    }
    <form method="post" asp-page-handler="Archive" asp-route-sin="@Model.Profile.Sin" class="section-panel mt-4">
        <h2 class="section-heading">Archive Profile</h2>
        <div class="form-check"><input asp-for="ConfirmArchive" class="form-check-input" required />
            <label asp-for="ConfirmArchive" class="form-check-label">Archive @Model.Profile.FullName (@Model.Profile.Sin). History will remain available.</label></div>
        <button class="btn btn-outline-danger mt-2" type="submit">Archive profile</button>
    </form>
}
<a class="btn btn-link" asp-page="/Profiles/Index">Back to Stall Owners</a>
