@page "/Profiles/{sin}/Billing"
@model BillingModel
@{
    ViewData["Title"] = "Billing history";
}
<div class="page-header"><div><p class="eyebrow">Stall owners / Billing</p><h1>Billing and Payments</h1><p>Review outstanding periods and recorded payments.</p></div></div>
@if (Model.Error is not null) { <p class="text-danger" role="alert">@Model.Error</p> }
@if (Model.Notice is not null) { <p class="text-success" role="status">@Model.Notice</p> }
@if (Model.Record is not null)
{
    <p><strong>@Model.Record.Name</strong> · <span class="status-badge @Model.Record.Status.ToLowerInvariant()">@Model.Record.Status</span></p>
    <p><a class="btn btn-outline-primary" asp-page="/Reports/RentalPaymentPreview" asp-route-selected="@RouteData.Values["sin"]">Print Rental Report</a></p>
    @if (Model.Record.IsLegacyBaseline) { <p class="form-text">December 1, 2026 is this legacy profile's computerized tracking baseline, not its verified historical occupancy date. December rent is immediately billable.</p> }
    @if (Model.Record.Archived) { <p>Archived profile. Billing generation is unavailable.</p> }
    else if (Model.Record.Status == "Unverified") { <p>Unverified profile. Billing generation is unavailable.</p> }
    else
    {
        <form method="post" asp-page-handler="Generate" asp-route-sin="@RouteData.Values["sin"]" class="d-inline">
            <button class="btn btn-outline-primary" type="submit">Generate missing billing periods</button>
        </form>
        <form method="post" asp-page-handler="Penalties" asp-route-sin="@RouteData.Values["sin"]" class="d-inline">
            <button class="btn btn-outline-secondary" type="submit">Recalculate profile penalty</button>
        </form>
    }
    <section class="section-panel mt-4"><h2 class="section-heading">Outstanding through @Model.AsOf.ToString("MMMM yyyy")</h2>
    @if (Model.Record.TotalDue is null)
    {
        <p class="text-danger" role="alert">An older bill with an additional charge needs review before payment. Its stored rent basis is unknown.</p>
    }
    <dl class="row detail-list">
        <dt class="col-sm-3">Base rent</dt><dd class="col-sm-9 money">@(Model.Record.RentDue.HasValue ? $"₱{Model.Record.RentDue:N2}" : "Review needed")</dd>
        <dt class="col-sm-3">Additional charge</dt><dd class="col-sm-9 money">@(Model.Record.AdditionalDue.HasValue ? $"₱{Model.Record.AdditionalDue:N2}" : "Review needed")</dd>
        <dt class="col-sm-3">Penalty</dt><dd class="col-sm-9 money">@(Model.Record.PenaltyDue.HasValue ? $"₱{Model.Record.PenaltyDue:N2}" : "Review needed")</dd>
        <dt class="col-sm-3">Total</dt><dd class="col-sm-9 money summary-total">@(Model.Record.TotalDue.HasValue ? $"₱{Model.Record.TotalDue:N2}" : "Review needed")</dd>
    </dl></section>
    @if (!Model.Record.Archived && Model.Record.Status != "Unverified" && Model.Record.TotalDue > 0)
    {
        <section class="section-panel"><h2 class="section-heading">Record Full Payment</h2>
        <p>One OR number settles every unpaid billing period through this month. Amount is calculated again when submitted.</p>
        <form method="post" asp-page-handler="Pay" asp-route-sin="@RouteData.Values["sin"]" style="max-width: 28rem">
            <div class="mb-3"><label class="form-label" asp-for="OrNumber">OR Number</label>
                <input class="form-control" asp-for="OrNumber" maxlength="100" required /></div>
            <div class="form-check mb-3"><input class="form-check-input" asp-for="ConfirmPayment" required />
                <label class="form-check-label" asp-for="ConfirmPayment">Confirm full payment of all outstanding periods</label></div>
            <button class="btn btn-primary" type="submit">Record payment</button>
        </form>
        </section>
    }
    <h2 class="section-heading">Billing Periods</h2><p class="form-text">Billing starts the month after occupancy. Payment is due by the 20th; a 25% base-rent penalty applies from the 21st.</p>
    <div class="table-responsive">
        <table class="table table-striped financial-table"><caption class="visually-hidden">Billing periods for @Model.Record.Name</caption>
            <thead><tr><th scope="col">Billing period</th><th scope="col">Due date</th><th scope="col">Base rent</th><th scope="col">Additional</th><th scope="col">Penalty</th><th scope="col">Status</th><th scope="col">OR number</th><th scope="col">Date paid</th></tr></thead>
            <tbody>
            @foreach (var row in Model.Record.Rows)
            {
                <tr><td>@(new DateTime(row.Year, row.Month, 1).ToString("MMMM yyyy"))</td><td>@(new DateTime(row.Year, row.Month, 20).ToString("MMMM dd, yyyy"))</td><td class="money">@(row.BaseRent.HasValue ? $"₱{row.BaseRent:N2}" : "Review needed")</td>
                    <td class="money">₱@row.Additional.ToString("N2")</td><td class="money">@(row.CurrentPenalty(Model.AsOf).HasValue ? $"₱{row.CurrentPenalty(Model.AsOf):N2}" : "Review needed")</td>
                    <td><span class="status-badge @row.Status.ToLowerInvariant()">@row.Status</span></td><td>@row.OrNumber</td><td>@row.DatePaid?.ToString("MMMM dd, yyyy")</td></tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.Record.Rows.Count == 0) { <p class="empty-state">No billing periods yet.</p> }
    @if (Model.Record.IsLegacyBaseline)
    {
        <section class="section-panel mt-4" id="verified-arrears">
            <h2 class="section-heading">Treasury-Verified Arrears</h2>
            <p>Enter prior unpaid rent from the Treasury logbook. Saving arrears does not record payment. Only an issued OR records payment.</p>
            @if (!Model.Record.Archived && Model.Record.Status != "Unverified")
            {
                <form method="post" asp-page-handler="SaveArrears" asp-route-sin="@RouteData.Values["sin"]" class="row g-3 align-items-end mb-4">
                    <div class="col-sm-2"><label class="form-label" for="arrears-year">Year</label><input class="form-control" id="arrears-year" name="ArrearsYear" type="number" min="2000" max="2100" required /></div>
                    <div class="col-sm-2"><label class="form-label" for="arrears-month">Month</label><select class="form-select" id="arrears-month" name="ArrearsMonth" required><option value="">Choose</option>@for (int month = 1; month <= 12; month++) { <option value="@month">@(new DateTime(2000, month, 1).ToString("MMMM"))</option> }</select></div>
                    <div class="col-sm-2"><label class="form-label" for="arrears-rent">Base Rent</label><input class="form-control" id="arrears-rent" name="ArrearsBaseRent" type="number" min="0.01" step="0.01" required /></div>
                    <div class="col-sm-2"><label class="form-label" for="arrears-additional">Additional Charge</label><input class="form-control" id="arrears-additional" name="ArrearsAdditional" type="number" min="0" step="0.01" value="0" required /></div>
                    <div class="col-sm-4"><label class="form-label" for="treasury-reference">Treasury Reference / Notes</label><input class="form-control" id="treasury-reference" name="TreasuryReference" maxlength="500" /></div>
                    <div class="col-12"><button class="btn btn-outline-primary" type="submit">Add Verified Arrears</button></div>
                </form>
            }
            <div class="table-responsive"><table class="table financial-table"><caption class="visually-hidden">Treasury-verified arrears</caption><thead><tr><th scope="col">Period</th><th scope="col">Base Rent</th><th scope="col">Additional</th><th scope="col">Penalty</th><th scope="col">Total</th><th scope="col">Status</th><th scope="col">Treasury Reference</th><th scope="col">Correction</th></tr></thead><tbody>
                @foreach (var item in Model.Record.Arrears)
                {
                    <tr><td>@(new DateTime(item.Year, item.Month, 1).ToString("MMMM yyyy"))</td><td class="money">₱@item.BaseRent.ToString("N2")</td><td class="money">₱@item.Additional.ToString("N2")</td><td class="money">₱@item.CurrentPenalty(Model.AsOf).ToString("N2")</td><td class="money">₱@item.Total(Model.AsOf).ToString("N2")</td><td>@(item.IsPaid ? "Paid" : "Unpaid")</td><td>@item.TreasuryReference</td><td>
                        @if (!item.IsPaid && !Model.Record.Archived)
                        {
                            <details><summary>Correct</summary><form method="post" asp-page-handler="SaveArrears" asp-route-sin="@RouteData.Values["sin"]" class="d-grid gap-2 mt-2" style="min-width: 12rem">
                                <input type="hidden" name="ArrearsId" value="@item.Id" />
                                <label>Year<input class="form-control" name="ArrearsYear" type="number" min="2000" max="2100" value="@item.Year" required /></label>
                                <label>Month<select class="form-select" name="ArrearsMonth" required>@for (int month = 1; month <= 12; month++) { <option value="@month" selected="@(month == item.Month)">@(new DateTime(2000, month, 1).ToString("MMMM"))</option> }</select></label>
                                <label>Base Rent<input class="form-control" name="ArrearsBaseRent" type="number" min="0.01" step="0.01" value="@item.BaseRent.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
                                <label>Additional Charge<input class="form-control" name="ArrearsAdditional" type="number" min="0" step="0.01" value="@item.Additional.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
                                <label>Treasury Reference<input class="form-control" name="TreasuryReference" maxlength="500" value="@item.TreasuryReference" /></label>
                                <button class="btn btn-outline-primary" type="submit">Save Correction</button>
                            </form></details>
                        }
                    </td></tr>
                }
            </tbody></table></div>
            @if (Model.Record.Arrears.Count == 0) { <p class="empty-state">No Treasury-verified arrears recorded.</p> }
        </section>
    }
    <h2 class="h4 mt-4">Payment History</h2>
    <div class="table-responsive"><table class="table table-striped financial-table"><caption class="visually-hidden">Payment history for @Model.Record.Name</caption>
        <thead><tr><th scope="col">OR number</th><th scope="col">Date</th><th scope="col">Amount</th><th scope="col">Penalty</th><th scope="col">Recorded by</th><th scope="col">Periods</th><th scope="col">Report</th></tr></thead>
        <tbody>
        @foreach (var payment in Model.Record.Payments)
        {
            <tr><td>@payment.OrNumber</td><td>@payment.DatePaid.ToString("MMMM dd, yyyy hh:mm tt")</td>
                <td class="money">₱@payment.Amount.ToString("N2")</td><td class="money">₱@payment.Penalty.ToString("N2")</td>
                <td>@payment.RecordedBy</td><td>@payment.Periods</td><td><a asp-page="/Reports/StallPaymentPreview" asp-route-sin="@RouteData.Values["sin"]" asp-route-orNumber="@payment.OrNumber">Print Payment Report</a></td></tr>
        }
        </tbody>
    </table></div>
    @if (Model.Record.Payments.Count == 0) { <p class="empty-state">No payment history yet.</p> }
}
<a asp-page="/Profiles/Details" asp-route-sin="@RouteData.Values["sin"]">Back to profile</a>
