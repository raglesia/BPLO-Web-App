@page
@model BusinessPermitLicensingSystem.Web.Pages.Archive.ProfilesModel
@{ ViewData["Title"] = "Archived profiles"; }
<div class="page-header"><div><p class="eyebrow">Archive</p><h1>Archived Profiles</h1><p>Restoring keeps the same SIN and history. Billing is generated only through the billing page.</p></div></div>
@if (Model.Error is not null) { <p class="text-danger" role="alert">@Model.Error</p> }
@if (Model.Notice is not null) { <p class="text-success" role="status">@Model.Notice</p> }
<form method="get" class="search-panel mb-3"><label for="Search" class="form-label">Search Archived Profiles</label>
    <input id="Search" name="Search" value="@Model.Search" class="form-control" style="max-width: 24rem" />
    <button class="btn btn-outline-primary mt-2">Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.Search)) { <a class="btn btn-link mt-2" asp-page="/Archive/Profiles">Clear Search</a> }</form>
<div class="table-responsive"><table class="table table-striped">
<thead><tr><th scope="col">SIN</th><th scope="col">Owner</th><th scope="col">Business</th><th scope="col">Stall</th><th scope="col">Status</th><th scope="col">History</th><th scope="col">Restore</th></tr></thead>
<tbody>
@foreach (var item in Model.Records)
{
    <tr><td>@item.Sin</td><td>@item.Owner</td><td>@item.Business</td><td>@item.Stall</td><td><span class="status-badge @item.Status.ToLowerInvariant()">@item.Status</span></td>
        <td><a asp-page="/Profiles/Billing" asp-route-sin="@item.Sin">Billing and payments</a></td>
        <td><form method="post" asp-page-handler="Restore" asp-route-sin="@item.Sin">
            <div class="form-check"><input type="checkbox" name="ConfirmRestore" value="true" id="confirm-@item.Sin" class="form-check-input" required />
                <label for="confirm-@item.Sin" class="form-check-label">Confirm @item.Owner (@item.Sin)</label></div>
            <button type="submit" class="btn btn-outline-primary btn-sm mt-1">Restore</button>
        </form></td></tr>
}
</tbody></table></div>
@if (Model.Records.Count == 0) { <p class="empty-state">No archived profiles found.</p> }
@if (Model.Records.Count == 100) { <p>Showing first 100 records. Narrow the search to find more.</p> }
