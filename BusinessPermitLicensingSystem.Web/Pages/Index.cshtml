@page
@model IndexModel
@{ ViewData["Title"] = "Dashboard"; }
<section class="dashboard-hero page-header" aria-labelledby="dashboard-title">
    <div><p class="eyebrow">Dashboard</p>
    <h1 id="dashboard-title">Administrative Dashboard</h1>
    <p>Overview of business profiles, permits, billing, and municipal collections.</p></div>
    <div class="page-actions"><a class="btn btn-primary" asp-page="/Profiles/Create">Add Stall Owner</a><a class="btn btn-outline-primary" asp-page="/Vehicles/Edit">Add Vehicle</a></div>
</section>
@if (Model.ActiveProfiles.HasValue)
{
    <section class="section-panel dashboard-summary" aria-labelledby="summary-title">
        <div class="summary-heading"><h2 id="summary-title" class="section-heading">Records Overview</h2></div>
        <div class="dashboard-kpi-grid">
            <div class="card metric-card metric-active"><div class="card-body"><div class="metric-title"><div class="label">Active Stall Owners</div><svg class="metric-icon" aria-hidden="true" focusable="false"><use href="#i-profiles" /></svg></div><div class="value">@Model.ActiveProfiles</div></div></div>
            <div class="card metric-card metric-warning"><div class="card-body"><div class="metric-title"><div class="label">Unverified Profiles</div><svg class="metric-icon" aria-hidden="true" focusable="false"><use href="#i-alert" /></svg></div><div class="value">@Model.UnverifiedProfiles</div></div></div>
            <div class="card metric-card metric-danger"><div class="card-body"><div class="metric-title"><div class="label">Unpaid Billing Periods</div><svg class="metric-icon" aria-hidden="true" focusable="false"><use href="#i-receipt" /></svg></div><div class="value">@Model.UnpaidPeriods</div></div></div>
            <div class="card metric-card metric-info"><div class="card-body"><div class="metric-title"><div class="label">Active Special Vehicle Permits</div><svg class="metric-icon" aria-hidden="true" focusable="false"><use href="#i-vehicles" /></svg></div><div class="value">@Model.ActiveVehicles</div></div></div>
        </div>
    </section>
    <section class="dashboard-collections" aria-labelledby="municipal-collections-title"><h2 id="municipal-collections-title" class="section-heading">Municipal Collections</h2><div class="collection-kpi-grid">
        <div class="card metric-card collection-card"><div class="card-body"><div class="metric-title"><div class="label">Stall Rent Collections</div><svg class="metric-icon" aria-hidden="true" focusable="false"><use href="#i-wallet" /></svg></div><div class="value money">@Model.RentCollectedThisMonth?.ToString("₱#,##0.00")</div><p class="hint">This month</p></div></div>
        <div class="card metric-card collection-card"><div class="card-body"><div class="metric-title"><div class="label">Special Vehicle Permit Collections</div><svg class="metric-icon" aria-hidden="true" focusable="false"><use href="#i-receipt" /></svg></div><div class="value money">@Model.VehicleCollectedThisMonth?.ToString("₱#,##0.00")</div><p class="hint">This month</p></div></div>
    </div></section>
}
else
{
    <p class="note" role="status">Record counts are unavailable. You can still open all work areas below.</p>
}
@if (Model.Collections.Count == 6)
{
    var maximum = Math.Max(1m, Model.Collections.Max(month => Math.Max(month.Rent, month.Vehicles)));
    <section class="section-panel dashboard-chart" aria-labelledby="collections-title">
        <div class="chart-heading"><div><h2 id="collections-title" class="section-heading">Monthly Collection Trend</h2><p>Recorded municipal collections for the previous six months.</p></div><div class="chart-legend"><span><i class="legend-swatch rent"></i> Stall rent</span><span><i class="legend-swatch vehicle"></i> Special vehicle permits</span></div></div>
        <div class="collection-chart" aria-hidden="true">
            @foreach (var month in Model.Collections)
            {
                <div class="chart-month"><div class="chart-bars"><div class="chart-bar rent" style="height:@((month.Rent / maximum * 100m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%" title="Stall rent: @month.Rent.ToString("₱#,##0.00")"></div><div class="chart-bar vehicle" style="height:@((month.Vehicles / maximum * 100m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%" title="Special vehicle permits: @month.Vehicles.ToString("₱#,##0.00")"></div></div><span>@month.Month.ToString("MMM")</span></div>
            }
        </div>
        <table class="visually-hidden"><caption>Monthly collections in pesos</caption><thead><tr><th scope="col">Month</th><th scope="col">Stall rent</th><th scope="col">Special vehicle permits</th></tr></thead><tbody>@foreach (var month in Model.Collections) { <tr><th scope="row">@month.Month.ToString("MMMM yyyy")</th><td>@month.Rent.ToString("₱#,##0.00")</td><td>@month.Vehicles.ToString("₱#,##0.00")</td></tr> }</tbody></table>
    </section>
}
<div class="row g-3">
    <section class="col-lg-6" aria-labelledby="quick-actions-title"><div class="section-panel h-100"><h2 id="quick-actions-title" class="section-heading">Quick actions</h2><div class="quick-actions">
        <a asp-page="/Profiles/Create">Add stall-owner profile <span aria-hidden="true">→</span></a>
        <a asp-page="/Vehicles/Edit">Add vehicle <span aria-hidden="true">→</span></a>
        <a asp-page="/Profiles/Index">Find a profile <span aria-hidden="true">→</span></a>
        <a asp-page="/Reports/Index">Open reports <span aria-hidden="true">→</span></a>
    </div></div></section>
    <section class="col-lg-6" aria-labelledby="attention-title"><div class="section-panel h-100"><h2 id="attention-title" class="section-heading">Needs attention</h2><ul class="attention-list">
        <li><a asp-page="/Profiles/Index" asp-route-search="Unverified"><span>Review unverified profiles</span><span class="status-badge unverified">@(Model.UnverifiedProfiles?.ToString() ?? "—")</span></a></li>
        <li><a asp-page="/Profiles/Index" asp-route-search="Unpaid"><span>Open unpaid billing periods</span><span class="status-badge unpaid">@(Model.UnpaidPeriods?.ToString() ?? "—")</span></a></li>
        @if (Model.ReviewNeededSin is not null) { <li><a asp-page="/Profiles/Billing" asp-route-sin="@Model.ReviewNeededSin"><span>Check older bills requiring review</span><span class="status-badge review">@Model.ReviewNeededPeriods</span></a></li> }
    </ul><p class="small mb-0">Counts are read-only and do not change billing or payment status.</p></div></section>
</div>
