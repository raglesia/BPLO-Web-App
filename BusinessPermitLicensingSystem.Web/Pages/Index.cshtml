@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var today = PhilippineBusinessClock.Today;
    var hasCollections = Model.Collections.Count == 6;
}
<header class="desk-header overview-header">
    <h1>Office Overview</h1>
    <div class="desk-actions">
        <a class="btn btn-primary" asp-page="/Profiles/Create">Add Stall Owner</a>
        <a class="btn btn-outline-primary" asp-page="/Vehicles/Edit">Add Vehicle</a>
    </div>
</header>
<div class="office-overview">
    <div class="office-operations">
        <section class="section-panel" aria-labelledby="reviews-title">
            <h2 id="reviews-title">Needs Attention</h2>
            @if (Model.UnverifiedProfiles is > 0)
            {
                <div class="review-item"><strong>@Model.UnverifiedProfiles awaiting occupancy verification</strong>
                    <a asp-page="/Profiles/Index" asp-route-search="Unverified">Review unverified profiles</a></div>
            }
            @if (Model.ReviewNeededSin is not null)
            {
                <div class="review-item"><strong>Treasury verification</strong>
                    <span>@Model.ReviewNeededPeriods older billing periods awaiting review</span>
                    <a asp-page="/Profiles/Billing" asp-route-sin="@Model.ReviewNeededSin">Review account @Model.ReviewNeededSin</a></div>
            }
            @if (!Model.UnverifiedProfiles.HasValue)
            { <p role="status">Review counts are unavailable.</p> }
            else if (Model.UnverifiedProfiles == 0 && Model.ReviewNeededPeriods == 0)
            { <p>No pending occupancy or Treasury reviews.</p> }
        </section>
        <section class="section-panel current-collections" aria-labelledby="current-title">
            <h2 id="current-title">Municipal Collections</h2>
            <p>@today.ToString("MMMM yyyy") · Month to date</p>
            @if (Model.RentCollectedThisMonth.HasValue && Model.VehicleCollectedThisMonth.HasValue)
            {
                <strong class="current-amount">@((Model.RentCollectedThisMonth.Value + Model.VehicleCollectedThisMonth.Value).ToString("₱#,##0.00"))</strong>
                <dl class="collection-split"><div><dt>Stall rent</dt><dd>@Model.RentCollectedThisMonth.Value.ToString("₱#,##0.00")</dd></div>
                <div><dt>Vehicle permits</dt><dd>@Model.VehicleCollectedThisMonth.Value.ToString("₱#,##0.00")</dd></div></dl>
            }
            else { <p role="status">Collection figures are unavailable.</p> }
            <a asp-page="/Reports/Monthly">Open monthly report</a>
        </section>
    </div>
    <section class="section-panel" aria-labelledby="records-title">
        <h2 id="records-title">Records Overview</h2>
        @if (!Model.ActiveProfiles.HasValue)
        { <p role="status">Record counts are unavailable. The directories are still accessible.</p> }
        <div class="record-strip">
            <div><strong>@(Model.ActiveProfiles?.ToString() ?? "—")</strong><a asp-page="/Profiles/Index">Active stall owners</a></div>
            <div><strong>@(Model.ActiveVehicles?.ToString() ?? "—")</strong><a asp-page="/Vehicles/Index">Active vehicles</a></div>
            <div><strong>@(Model.UnpaidPeriods?.ToString() ?? "—")</strong><span>Unpaid billing periods</span><a asp-page="/Profiles/Index" asp-route-search="Unpaid">Find unpaid profiles</a></div>
            <div><strong>@(Model.ArchivedProfiles?.ToString() ?? "—")</strong><a asp-page="/Archive/Profiles">Archived stall owners</a></div>
        </div>
    </section>
    @if (!hasCollections || !Model.ActiveProfiles.HasValue)
    {
        <div><a asp-page="/Index" id="dashboard-retry">Retry dashboard</a>
            <span id="dashboard-refresh-status" role="status"></span></div>
    }
    @if (hasCollections)
    {
    <div class="office-history">
    <section class="section-panel" aria-labelledby="collections-title">
        <h2 id="collections-title">Collection Activity</h2>
        <p>@Model.Collections[0].Month.ToString("MMM yyyy") – @today.ToString("d MMM yyyy")</p>
        @if (Model.Collections.Any(month => month.Rent != 0 || month.Vehicles != 0))
        {
        var maximum = Math.Max(1m, Model.Collections.Max(month => Math.Max(month.Rent, month.Vehicles)));
        <div class="midnight-plot">
            <div class="midnight-scale" aria-hidden="true"><span>@maximum.ToString("₱#,##0.00")</span><span>₱0</span></div>
            <div class="collection-chart" data-collection-chart>
                @foreach (var month in Model.Collections)
                {
                    var rentHeight = (month.Rent / maximum * 100m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                    var vehicleHeight = (month.Vehicles / maximum * 100m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                    var breakdown = $"{month.Month:MMMM yyyy}: stall rent {month.Rent:₱#,##0.00}, vehicle permits {month.Vehicles:₱#,##0.00}, total {month.Rent + month.Vehicles:₱#,##0.00}.";
                    <button type="button" class="chart-month" aria-label="@breakdown" data-collection-month="@breakdown">
                        <span class="chart-bars" aria-hidden="true">
                            <span class="chart-bar rent" style="height:@(rentHeight)%"></span>
                            <span class="chart-bar vehicle" style="height:@(vehicleHeight)%"></span>
                        </span>
                        <span class="chart-month-label" aria-hidden="true">@month.Month.ToString("MMM")</span>
                    </button>
                }
            </div>
        </div>
        <p id="collection-breakdown" class="collection-breakdown">Select a month for its collection breakdown.</p>
        <div class="chart-legend"><span><i class="legend-swatch rent"></i> Stall rent</span><span><i class="legend-swatch vehicle"></i> Vehicle permits</span></div>
        }
        else { <p>No recorded collections in this period.</p> }
    </section>
    <section class="section-panel" aria-labelledby="register-title">
        <h2 id="register-title">Monthly Collection Register</h2>
        <div class="table-responsive"><table class="table financial-table"><caption class="visually-hidden">Monthly municipal collections in Philippine pesos</caption>
        <thead><tr><th scope="col">Month</th><th scope="col" class="text-end">Total recorded</th><th scope="col" class="text-end">Stall rent</th><th scope="col" class="text-end">Vehicle permits</th></tr></thead><tbody>
        @foreach (var month in Model.Collections.Reverse())
        {
            <tr><th scope="row">@month.Month.ToString("MMM yyyy")</th><td class="text-end"><strong>@((month.Rent + month.Vehicles).ToString("₱#,##0.00"))</strong></td>
            <td class="text-end">@month.Rent.ToString("₱#,##0.00")</td><td class="text-end">@month.Vehicles.ToString("₱#,##0.00")</td></tr>
        }
        </tbody></table></div>
    </section>
    </div>
    }
    <partial name="_WorkflowGuide" />
</div>
