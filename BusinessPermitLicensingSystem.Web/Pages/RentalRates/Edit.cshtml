@page "{section?}"
@model BusinessPermitLicensingSystem.Web.Pages.RentalRates.EditModel
@{ ViewData["Title"] = Model.IsNew ? "Add rental section" : "Edit rental rate"; }
<div class="page-header"><div><p class="eyebrow">Rental rates</p><h1>@ViewData["Title"]</h1><p>Set one positive rate for the selected rate type.</p></div></div>
@if (Model.Error is not null) { <p class="text-danger" role="alert">@Model.Error</p> }
<form method="post" class="form-panel" style="max-width: 36rem">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    @if (Model.IsNew)
    { <div class="mb-3"><label asp-for="Input.Section" class="form-label">Section Name</label>
        <input asp-for="Input.Section" class="form-control" maxlength="255" required /></div> }
    else
    { <p><strong>Section:</strong> @Model.Section</p> }
    <div class="mb-3"><label asp-for="Input.RateType" class="form-label">Rate Type</label>
        <select asp-for="Input.RateType" class="form-select"><option value="PerSqm">Per square meter</option><option value="Flat">Flat</option></select></div>
    <div class="mb-3"><label asp-for="Input.RatePerSqm" class="form-label">Rate per sqm (₱)</label>
        <input asp-for="Input.RatePerSqm" type="number" min="0" step="0.01" class="form-control" />
        <span asp-validation-for="Input.RatePerSqm" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Input.FlatRate" class="form-label">Flat Rate (₱)</label>
        <input asp-for="Input.FlatRate" type="number" min="0" step="0.01" class="form-control" />
        <span asp-validation-for="Input.FlatRate" class="text-danger"></span></div>
    <p>Enter a positive rate for the selected type. The other rate is stored as zero.</p>
    <div class="form-check mb-3"><input asp-for="Input.Confirm" class="form-check-input" required />
        <label asp-for="Input.Confirm" class="form-check-label">Confirm this rental-rate change</label></div>
    <div class="form-actions"><button type="submit" class="btn btn-primary">Save Rate</button>
    <a class="btn btn-outline-secondary" asp-page="/RentalRates/Index">Cancel</a></div>
</form>
